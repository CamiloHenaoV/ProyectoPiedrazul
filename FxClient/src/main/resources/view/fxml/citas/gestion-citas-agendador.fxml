<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.piedrazul.frontend.controller.GestionCitasAgendadorController"
            prefWidth="1050" prefHeight="680">

    <!-- ── Encabezado ─────────────────────────────────────────────────────── -->
    <top>
        <VBox style="-fx-background-color: #1565C0;">
            <padding><Insets top="16" right="30" bottom="16" left="30"/></padding>
            <Label text="Gestión de Citas" style="-fx-text-fill: white; -fx-font-weight: bold;">
                <font><Font size="20"/></font>
            </Label>
        </VBox>
    </top>

    <!-- ── Contenido principal ────────────────────────────────────────────── -->
    <center>
        <VBox spacing="18">
            <padding><Insets top="20" right="30" bottom="10" left="30"/></padding>

            <!-- Filtros de búsqueda (HU-6.1) -->
            <TitledPane text="Buscar citas por profesional y fecha" collapsible="false"
                        style="-fx-font-size: 13px;">
                <GridPane hgap="16" vgap="12">
                    <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>

                    <columnConstraints>
                        <ColumnConstraints minWidth="130" prefWidth="140"/>
                        <ColumnConstraints minWidth="220" prefWidth="260" hgrow="ALWAYS"/>
                        <ColumnConstraints minWidth="100" prefWidth="120"/>
                        <ColumnConstraints minWidth="220" prefWidth="240" hgrow="ALWAYS"/>
                        <ColumnConstraints minWidth="100" prefWidth="110"/>
                    </columnConstraints>

                    <Label text="Especialidad:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                           GridPane.valignment="CENTER"/>
                    <ComboBox fx:id="cbEspecialidad"
                              promptText="Seleccionar especialidad"
                              maxWidth="Infinity"
                              GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Profesional:" GridPane.rowIndex="0" GridPane.columnIndex="2"
                           GridPane.valignment="CENTER"/>
                    <ComboBox fx:id="cbProfesional"
                              promptText="Seleccionar profesional"
                              maxWidth="Infinity"
                              GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                    <Label text="Fecha:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                           GridPane.valignment="CENTER"/>
                    <DatePicker fx:id="dpFecha"
                                promptText="dd/mm/aaaa"
                                maxWidth="Infinity"
                                GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Button fx:id="btnBuscar" text="BUSCAR"
                            onAction="#handleBuscar"
                            defaultButton="true"
                            style="-fx-background-color: #1565C0; -fx-text-fill: white; -fx-cursor: hand;"
                            GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                </GridPane>
            </TitledPane>

            <!-- Total de citas (HU-6.1 CA-1) -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Resultados:" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblTotalCitas" style="-fx-text-fill: #1565C0; -fx-font-weight: bold;"/>
            </HBox>

            <!-- Tabla de citas (HU-6.1 CA-4) -->
            <TableView fx:id="tablaCitas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colPaciente" text="Paciente"  prefWidth="280"/>
                    <TableColumn fx:id="colHora"     text="Hora"      prefWidth="100"/>
                    <TableColumn fx:id="colEstado"   text="Estado"    prefWidth="140"/>
                </columns>
            </TableView>

            <!-- Mensaje de estado / error -->
            <Label fx:id="lblMensaje" text="" wrapText="true"/>
        </VBox>
    </center>

    <!-- ── Barra de acciones ──────────────────────────────────────────────── -->
    <bottom>
        <HBox spacing="12" alignment="CENTER_RIGHT">
            <padding><Insets top="12" right="30" bottom="20" left="30"/></padding>

            <Button text="← Volver" onAction="#volver" style="-fx-cursor: hand;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- HU-6.2: Registrar nueva cita manual -->
            <Button fx:id="btnRegistrarNueva"
                    text="+ Registrar cita"
                    onAction="#handleRegistrarNueva"
                    style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-cursor: hand;"/>

            <!-- HU-6.3: Modificar / reprogramar -->
            <Button fx:id="btnModificar"
                    text="Reprogramar"
                    onAction="#handleModificar"
                    disable="true"
                    style="-fx-background-color: #E65100; -fx-text-fill: white; -fx-cursor: hand;"/>

            <!-- HU-6.4: Cancelar cita -->
            <Button fx:id="btnCancelar"
                    text="Cancelar cita"
                    onAction="#handleCancelar"
                    disable="true"
                    style="-fx-background-color: #C62828; -fx-text-fill: white; -fx-cursor: hand;"/>
        </HBox>
    </bottom>

</BorderPane>
