<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.piedrazul.frontend.controller.ConfiguracionAgendamientoController">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-background-color: #2c3e50; -fx-padding: 12 20 12 20;">
            <Button text="← Volver" onAction="#onVolver"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13;"/>
            <Label text="Ventana de Tiempo para Agendamiento"
                   style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;"/>
            <Label text="HU-1.7"
                   style="-fx-text-fill: #95a5a6; -fx-font-size: 11;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 40 60 40 60;">

            <!-- Descripción -->
            <Label wrapText="true" maxWidth="500"
                   text="Configure cuántas semanas hacia adelante pueden los pacientes reservar citas. Fechas fuera de este rango serán bloqueadas automáticamente."
                   style="-fx-text-fill: #555; -fx-font-size: 13;"/>

            <Separator/>

            <!-- Control principal -->
            <HBox spacing="16" alignment="CENTER_LEFT">
                <Label text="Semanas habilitadas:" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                <Spinner fx:id="spnSemanas" prefWidth="100"/>
                <Label text="semanas (1 – 52)" style="-fx-text-fill: #7f8c8d;"/>
            </HBox>

            <!-- Fecha máxima resultante (HU-1.7 SC-2) -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-background-color: #ecf0f1; -fx-padding: 12 16 12 16; -fx-background-radius: 6;">
                <Label text="📅" style="-fx-font-size: 16;"/>
                <Label fx:id="lblFechaMaxima"
                       text="Fecha máxima actual: calculando..."
                       style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            </HBox>

            <!-- Mensaje de resultado (SC-1 / SC-3) -->
            <Label fx:id="lblMensaje" wrapText="true" maxWidth="500"/>

            <!-- Botón guardar -->
            <HBox>
                <Button fx:id="btnGuardar" text="Guardar configuración" onAction="#onGuardar"
                        style="-fx-background-color: #2980b9; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-font-size: 13;
                               -fx-padding: 8 28 8 28; -fx-background-radius: 6;"/>
            </HBox>

            <Separator/>

            <!-- Nota informativa -->
            <VBox spacing="6" style="-fx-padding: 12 16 12 16; -fx-background-color: #fff9e6;
                                     -fx-border-color: #f0c040; -fx-border-radius: 4;
                                     -fx-background-radius: 4;">
                <Label text="ℹ️  Información" style="-fx-font-weight: bold;"/>
                <Label wrapText="true" maxWidth="460"
                       text="Al reducir el número de semanas, las citas ya agendadas fuera del nuevo rango NO se cancelarán automáticamente. Solo se impedirán nuevas reservas en esas fechas."
                       style="-fx-text-fill: #555; -fx-font-size: 12;"/>
            </VBox>

        </VBox>
    </center>

</BorderPane>
