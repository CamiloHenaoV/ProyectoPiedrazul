<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.piedrazul.frontend.controller.DashboardAdminController">

    <!-- SIDEBAR -->
    <left>
        <VBox spacing="8" prefWidth="220"
              style="-fx-background-color: #2c3e50; -fx-padding: 20 10 20 10;">

            <Label text="Piedrazul"
                   style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;
                          -fx-padding: 0 0 4 6;"/>
            <Label fx:id="lblUsuario"
                   style="-fx-text-fill: #bdc3c7; -fx-font-size: 12; -fx-padding: 0 0 8 6;"/>

            <Separator style="-fx-background-color: #3d5166;"/>

            <!-- Sección Usuarios -->
            <Label text="USUARIOS" style="-fx-text-fill: #7f8c8d; -fx-font-size: 10;
                                          -fx-padding: 10 0 4 6;"/>
            <Button text="Gestión de Usuarios"
                    maxWidth="Infinity" onAction="#irAUsuarios"
                    style="-fx-background-color: transparent; -fx-text-fill: white;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 10 7 10;"/>

            <Separator style="-fx-background-color: #3d5166;"/>

            <!-- Sección Agenda -->
            <Label text="CONFIGURACIÓN AGENDA" style="-fx-text-fill: #7f8c8d; -fx-font-size: 10;
                                                       -fx-padding: 10 0 4 6;"/>

            <!-- HU-1.5 / HU-1.6 -->
            <Button text="Disponibilidad de Profesionales"
                    maxWidth="Infinity" onAction="#irADisponibilidad"
                    style="-fx-background-color: transparent; -fx-text-fill: white;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 10 7 10;"/>

            <!-- HU-1.7 -->
            <Button text="Ventana de Agendamiento"
                    maxWidth="Infinity" onAction="#irAConfiguracionAgendamiento"
                    style="-fx-background-color: transparent; -fx-text-fill: white;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 10 7 10;"/>

            <!-- HU-1.8 -->
            <Button text="Días No Disponibles / Festivos"
                    maxWidth="Infinity" onAction="#irADiasNoDisponibles"
                    style="-fx-background-color: transparent; -fx-text-fill: white;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 10 7 10;"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <Separator style="-fx-background-color: #3d5166;"/>
            <Button text="Cerrar Sesión"
                    maxWidth="Infinity" onAction="#cerrarSesion"
                    style="-fx-background-color: #c0392b; -fx-text-fill: white;
                           -fx-padding: 7 10 7 10;"/>
        </VBox>
    </left>

    <!-- CONTENIDO PRINCIPAL -->
    <center>
        <VBox spacing="24" style="-fx-padding: 36 36 36 36;">

            <Label text="Panel de Administración"
                   style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <!-- Tarjeta de métricas -->
            <HBox spacing="20">
                <VBox prefWidth="180" prefHeight="100" alignment="CENTER" spacing="6"
                      style="-fx-background-color: #3498db; -fx-background-radius: 8;
                             -fx-padding: 16;">
                    <Label fx:id="lblTotalUsuarios" text="0"
                           style="-fx-text-fill: white; -fx-font-size: 32; -fx-font-weight: bold;"/>
                    <Label text="Usuarios activos"
                           style="-fx-text-fill: #d6eaf8; -fx-font-size: 12;"/>
                </VBox>
            </HBox>

            <Separator/>

            <!-- Accesos rápidos -->
            <Label text="Accesos rápidos"
                   style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #555;"/>

            <HBox spacing="12">
                <Button text="👥  Gestionar Usuarios"
                        onAction="#irAUsuarios"
                        prefWidth="200" prefHeight="60"
                        style="-fx-background-color: #ecf0f1; -fx-font-size: 13;"/>
                <Button text="🗓️  Disponibilidad"
                        onAction="#irADisponibilidad"
                        prefWidth="200" prefHeight="60"
                        style="-fx-background-color: #ecf0f1; -fx-font-size: 13;"/>
                <Button text="⏰  Ventana Agendamiento"
                        onAction="#irAConfiguracionAgendamiento"
                        prefWidth="200" prefHeight="60"
                        style="-fx-background-color: #ecf0f1; -fx-font-size: 13;"/>
                <Button text="🚫  Días No Disponibles"
                        onAction="#irADiasNoDisponibles"
                        prefWidth="200" prefHeight="60"
                        style="-fx-background-color: #ecf0f1; -fx-font-size: 13;"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>
